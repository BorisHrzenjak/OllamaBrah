{
  "name": "ollama-brah",
  "version": "1.0.6",
  "description": "Ollama Brah - Standalone Electron chat app for local Ollama models",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.ollamabrah.app",
    "productName": "Ollama Brah",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "files": [
      "main.js",
      "preload.js",
      "whisper_server.py",
      "renderer/**/*",
      "proxy/**/*",
      "assets/**/*"
    ],
    "asarUnpack": [
      "whisper_server.py"
    ]
  },
  "dependencies": {
    "better-sqlite3": "^9.6.0",
    "cors": "^2.8.5",
    "diff": "^8.0.3",
    "dotenv": "^17.3.1",
    "electron-store": "^8.2.0",
    "express": "^4.19.2",
    "kokoro-js": "^1.2.1",
    "pdf-parse": "^1.1.1",
    "vectra": "^0.9.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}
